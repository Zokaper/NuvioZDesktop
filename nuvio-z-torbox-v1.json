  "config": {
    "services": [
      {
        "id": "torbox",
        "enabled": true,
        "credentials": {
          "apiKey": "{{services.torbox.apiKey}}"
        }
      }
    ],
    "presets": [
      {
        "type": "seadex",
        "instanceId": "326",
        "enabled": true,
        "options": {
          "name": "SeaDex",
          "timeout": 5000,
          "mediaTypes": [
            "anime"
          ]
        },
        "category": "Debrid"
      },
      {
        "type": "neko-bt",
        "instanceId": "072",
        "enabled": true,
        "options": {
          "name": "nekoBT",
          "timeout": 5000,
          "mediaTypes": [
            "anime"
          ],
          "useMultipleInstances": false,
          "leaveAutoTitleTagsInFilename": true
        },
        "category": "Debrid"
      },
      {
        "type": "torznab",
        "instanceId": "6a6",
        "enabled": true,
        "options": {
          "name": "ComeTorz",
          "timeout": 5000,
          "mediaTypes": [],
          "searchMode": "auto",
          "seasonEpisodeStrategy": "dynamic",
          "paginate": false,
          "useMultipleInstances": false,
          "api": {
            "url": "https://comet.feels.legal/torznab/api"
          }
        },
        "category": "Debrid"
      },
      {
        "type": "stremthruTorz",
        "instanceId": "609",
        "enabled": true,
        "options": {
          "name": "STorz",
          "timeout": 5000,
          "resources": [
            "stream"
          ],
          "url": "",
          "mediaTypes": [],
          "includeP2P": false,
          "useMultipleInstances": false
        },
        "category": "Debrid"
      },
      {
        "type": "meteor",
        "instanceId": "ddd",
        "enabled": true,
        "options": {
          "name": "Meteor",
          "timeout": 5000,
          "resources": [
            "stream"
          ],
          "includeP2P": false,
          "removeTrash": false,
          "useMultipleInstances": false,
          "mediaTypes": [],
          "yourMedia": {
            "sources": [
              "torrent",
              "webdl"
            ],
            "showStreams": true,
            "enabled": true
          },
          "usenet": {
            "enabled": false,
            "customSearchEngines": false
          }
        },
        "category": "Debrid"
      },
      {
        "type": "knaben",
        "instanceId": "dc9",
        "enabled": true,
        "options": {
          "name": "Knaben",
          "timeout": 5000,
          "mediaTypes": [],
          "useMultipleInstances": false
        },
        "category": "Debrid"
      },
      {
        "type": "mediafusion",
        "instanceId": "276",
        "enabled": true,
        "options": {
          "name": "MediaFusion",
          "timeout": 5000,
          "resources": [
            "stream"
          ],
          "useCachedResultsOnly": false,
          "enableWatchlistCatalogs": false,
          "downloadViaBrowser": false,
          "contributorStreams": false,
          "certificationLevelsFilter": [],
          "nudityFilter": [],
          "mediaTypes": [],
          "url": "",
          "includeP2P": false
        },
        "category": "Debrid"
      },
      {
        "type": "opensubtitles-v3-plus",
        "instanceId": "262",
        "enabled": true,
        "options": {
          "name": "OpenSubtitles V3+",
          "timeout": 5000,
          "resources": [
            "subtitles"
          ],
          "sources": "all",
          "includeAiTranslated": false,
          "movieHashPlusAutoAdjustment": false,
          "language": [
            "en"
          ]
        },
        "category": "Subs"
      },
      {
        "type": "comet",
        "instanceId": "f18",
        "enabled": true,
        "options": {
          "name": "Comet",
          "timeout": 7000,
          "resources": [
            "stream"
          ],
          "includeP2P": false,
          "removeTrash": true,
          "scrapeDebridAccountTorrents": false,
          "useMultipleInstances": false,
          "mediaTypes": []
        }
      }
    ],
    "preferredQualities": [],
    "preferredResolutions": [],
    "preferredLanguages": [
      "{{inputs.sourceLanguages}}",
      "Original",
      "Dual Audio",
      "Multi",
      "Dubbed",
      "Unknown"
    ],
    "preferredSubtitles": [
      "{{inputs.subtitleLanguages}}"
    ],
    "preferredVisualTags": [],
    "preferredAudioTags": [],
    "preferredAudioChannels": [],
    "preferredStreamTypes": [],
    "preferredEncodes": [],
    "excludedQualities": [],
    "includedQualities": [],
    "requiredQualities": [],
    "excludedResolutions": [],
    "includedResolutions": [],
    "requiredResolutions": [],
    "excludedLanguages": [],
    "includedLanguages": [],
    "requiredLanguages": [],
    "excludedSubtitles": [],
    "includedSubtitles": [],
    "requiredSubtitles": [],
    "excludedVisualTags": [
      "3D",
      "H-OU",
      "H-SBS"
    ],
    "includedVisualTags": [],
    "requiredVisualTags": [],
    "excludedAudioTags": [],
    "includedAudioTags": [],
    "requiredAudioTags": [],
    "excludedAudioChannels": [],
    "includedAudioChannels": [],
    "requiredAudioChannels": [],
    "excludedStreamTypes": [],
    "includedStreamTypes": [],
    "requiredStreamTypes": [],
    "excludedEncodes": [],
    "includedEncodes": [],
    "requiredEncodes": [],
    "deduplicator": {
      "enabled": true,
      "excludeAddons": [],
      "multiGroupBehaviour": "aggressive",
      "keys": [
        "filename",
        "infoHash",
        "smartDetect"
      ],
      "cached": "single_result",
      "uncached": "single_result",
      "p2p": "single_result",
      "http": "per_addon",
      "smartDetectAttributes": [
        "size",
        "resolution",
        "quality",
        "visualTags",
        "audioTags",
        "audioChannels",
        "languages",
        "encode",
        "edition",
        "network",
        "remastered",
        "bitrate",
        "releaseGroup"
      ],
      "smartDetectRounding": 10,
      "libraryBehaviour": "prefer",
      "merge": {
        "enabled": true,
        "failoverVariants": true,
        "fields": [
          "sizes",
          "seadex",
          "library",
          "subtitles",
          "languages"
        ]
      }
    },
    "seasonEpisodeMatching": {
      "enabled": true,
      "strict": true,
      "requestTypes": [
        "movie",
        "series",
        "anime"
      ],
      "addons": []
    },
    "yearMatching": {
      "enabled": false,
      "tolerance": 1,
      "strict": true,
      "strictTypes": [
        "movie"
      ],
      "useInitialAirDate": true,
      "requestTypes": [
        "movie",
        "series",
        "anime"
      ],
      "addons": []
    },
    "titleMatching": {
      "mode": "exact",
      "similarityThreshold": 1,
      "enabled": false,
      "ambiguousResults": "discard",
      "requestTypes": [
        "movie",
        "series",
        "anime"
      ],
      "addons": []
    },
    "digitalReleaseFilter": {
      "enabled": false,
      "tolerance": 0,
      "requestTypes": [
        "movie",
        "series",
        "anime"
      ],
      "addons": []
    },
    "enableSeadex": true,
    "checkOwned": true,
    "precacheNextEpisode": false,
    "precacheSingleStream": false,
    "statistics": {
      "enabled": false,
      "position": "bottom",
      "statsToShow": [
        "addon",
        "filter",
        "timing"
      ],
      "showFilterStatsOnNoStreams": false
    },
    "proxy": {
      "id": "builtin",
      "proxiedServices": []
    },
    "trusted": false,
    "hideErrors": true,
    "hideErrorsForResources": [
      "addon_catalog",
      "catalog",
      "subtitles"
    ],
    "addonName": "Nuvio Z Recommended",
    "addonDescription": "A lightweight AIOStreams configuration for Nuvio Z using TorBox. Nuvio Z handles playback-mode, quality, HDR, audio and subtitle preferences."
  }
}
